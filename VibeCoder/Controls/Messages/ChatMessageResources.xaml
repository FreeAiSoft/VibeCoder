<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:VibeCoder.Core.Services;assembly=VibeCoder.Core"
                    xmlns:conv="clr-namespace:VibeCoder.Converters"
                    xmlns:controls="clr-namespace:VibeCoder.Controls.Messages">

    <SolidColorBrush x:Key="Chat.UserBorder" Color="#CC64B5F6"/>
    <SolidColorBrush x:Key="Chat.UserBackground" Color="#3364B5F6"/>
    <SolidColorBrush x:Key="Chat.LastActBackground" Color="#334CAF50"/>
    <SolidColorBrush x:Key="Chat.LastActBorder" Color="#4CAF50"/>
    <SolidColorBrush x:Key="Chat.LastPlanBackground" Color="#4DFF8C00"/>
    <SolidColorBrush x:Key="Chat.LastPlanBorder" Color="#FF8C00"/>
    <SolidColorBrush x:Key="Question.OptionBorder" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Question.AnswerBorder" Color="#4CAF50"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:CodeTokensToTextBlockConverter x:Key="CodeToTextBlock"/>
    <conv:MarkdownToElementConverter x:Key="MarkdownToElement"/>
    <conv:OptionEqualsAnswerConverter x:Key="OptionEqualsAnswerConverter"/>
    <conv:TimestampToTextConverter x:Key="TimestampToText"/>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Dark.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuestionOptionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Dark.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Question.OptionBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="#666666" CornerRadius="2.5"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#999999"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#BBBBBB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="5"/>
        <Setter Property="MinWidth" Value="5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Height" Value="5"/>
                            <Setter Property="MinHeight" Value="5"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type core:TextMessageBlock}">
        <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="{DynamicResource Dark.Text}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.KindName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Error">
                            <Setter Property="Foreground" Value="{DynamicResource Dark.ErrorText}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type core:CodeMessageBlock}">
        <Border Background="{DynamicResource Code.Background}" BorderBrush="{DynamicResource Dark.Border}"
                BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
            <controls:CodeScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding Tokens, Mode=OneWay, Converter={StaticResource CodeToTextBlock}}"/>
            </controls:CodeScrollViewer>
        </Border>
    </DataTemplate>


    <Style x:Key="{x:Type controls:MessageChrome}" TargetType="{x:Type controls:MessageChrome}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MessageChrome}">
                    <Border Padding="8,6" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Dark.Control}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Dark.Border}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KindName}" Value="User">
                                        <Setter Property="BorderBrush" Value="{StaticResource Chat.UserBorder}"/>
                                        <Setter Property="Background" Value="{StaticResource Chat.UserBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ToolBlocked">
                                        <Setter Property="BorderBrush" Value="#B0563C"/>
                                        <Setter Property="Background" Value="#33221E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Error">
                                        <Setter Property="BorderBrush" Value="#B0563C"/>
                                        <Setter Property="Background" Value="#331F1F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Compaction">
                                        <Setter Property="BorderBrush" Value="#6B6B2E"/>
                                        <Setter Property="Background" Value="#262618"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                        <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                        <Setter Property="Background" Value="#1E2733"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Question">
                                        <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                        <Setter Property="Background" Value="#1E2733"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Subagent">
                                        <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                        <Setter Property="Background" Value="#1E2733"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Checkpoint">
                                        <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                        <Setter Property="Background" Value="#1E2733"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                                        <Setter Property="BorderBrush" Value="{StaticResource Chat.LastPlanBorder}"/>
                                        <Setter Property="Background" Value="{StaticResource Chat.LastPlanBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                                        <Setter Property="BorderBrush" Value="{StaticResource Chat.LastActBorder}"/>
                                        <Setter Property="Background" Value="{StaticResource Chat.LastActBackground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Expander Grid.Row="0" Header="{Binding ReasoningHeader, Mode=OneWay}" IsExpanded="{Binding IsThinking, Mode=OneWay}" Foreground="{DynamicResource Dark.Text}" Visibility="{Binding ShowReasoning, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding Reasoning, Mode=OneWay}" TextWrapping="Wrap" Foreground="#C8C8C8" FontStyle="Italic" Padding="0"/>
                                </ScrollViewer>
                            </Expander>
                            <ContentPresenter Grid.Row="1"/>
                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Foreground="{DynamicResource Dark.Text}" Text="{Binding TimestampUtc, Converter={StaticResource TimestampToText}}"/>
                                <Button x:Name="ChevronButton" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}" Width="16" Height="16" Visibility="{Binding IsExpandable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" ToolTip="Expand/collapse message">
                                    <Viewbox Width="12" Height="12">
                                        <Grid>
                                            <Polyline x:Name="ChevronRight" Points="9,18 15,12 9,6" Stroke="{DynamicResource Dark.Text}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                            <Polyline x:Name="ChevronDown" Points="6,9 12,15 18,9" Stroke="{DynamicResource Dark.Text}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Visibility="Collapsed"/>
                                        </Grid>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="CopyButton" Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}" Width="16" Height="16" ToolTip="Copy message">
                                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Fill="{DynamicResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChevronRight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ChevronDown" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
