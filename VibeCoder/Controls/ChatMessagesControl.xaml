<UserControl x:Class="VibeCoder.Controls.ChatMessagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:messages="clr-namespace:VibeCoder.Controls.Messages"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Messages/ChatMessageResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="BlocksBodyTemplate">
                <ItemsControl ItemsSource="{Binding Blocks, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>

            <DataTemplate x:Key="MarkdownBodyTemplate">
                <StackPanel>
                    <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Dark.Text}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <ContentControl Content="{Binding Text, Mode=OneWay, Converter={StaticResource MarkdownToElement}}"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="UserTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="AgentTextTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="SystemNoticeTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="CompactionTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="ModeSwitchTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="DiffEditTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="ErrorTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="ToolBlockedTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>

            <DataTemplate x:Key="ResultAnswerPlanTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkdownBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>
            <DataTemplate x:Key="ResultAnswerActTemplate">
                <messages:MessageChrome>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MarkdownBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>

            <DataTemplate x:Key="ToolCallTemplate">
                <messages:MessageChrome IsExpandable="{Binding CanExpandTool}" IsExpanded="{Binding IsToolExpanded, Mode=TwoWay}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BlocksBodyTemplate}"/>
                </messages:MessageChrome>
            </DataTemplate>

            <DataTemplate x:Key="QuestionTemplate">
                <messages:MessageChrome>
                    <StackPanel>
                        <TextBlock Text="{Binding Payload.Question}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Dark.Text}"/>
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Payload.IsAnswered}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ItemsControl ItemsSource="{Binding Payload.Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Tag="{Binding}" Click="OnQuestionOptionClick" Margin="0,0,6,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource QuestionOptionButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource OptionEqualsAnswerConverter}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.Payload.Answer" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Question.AnswerBorder}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Skip" Click="OnQuestionSkip" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource QuestionOptionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.IsSkipped}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Question.AnswerBorder}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding Payload.Answer}" TextWrapping="Wrap" FontStyle="Italic"
                                       Foreground="{DynamicResource Dark.Text}" Margin="0,8,0,0"
                                       Visibility="{Binding Payload.HasFreeTextAnswer, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </messages:MessageChrome>
            </DataTemplate>

            <DataTemplate x:Key="SubagentTemplate">
                <messages:MessageChrome>
                    <StackPanel>
                        <TextBlock Text="{Binding Payload.Item.Prompt}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Dark.Text}"/>
                        <TextBlock Text="{Binding Payload.Item.StatusText}" Foreground="#C8C8C8" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Payload.Item.LatestToolCall}" Foreground="#9A9A9A" FontFamily="Consolas"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Payload.Item.LatestToolCall}"/>
                        <Expander Header="Show output" Margin="0,8,0,0" Foreground="{DynamicResource Dark.Text}" IsExpanded="False"
                                  Visibility="{Binding Payload.Item.HasOutput, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Payload.Item.Result, Mode=OneWay}" TextWrapping="Wrap"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource Dark.Text}" MaxHeight="400" VerticalScrollBarVisibility="Auto"/>
                        </Expander>
                        <TextBlock Text="{Binding Payload.Item.Error}" Foreground="{DynamicResource Dark.ErrorText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Payload.Item.HasError, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </messages:MessageChrome>
            </DataTemplate>

            <DataTemplate x:Key="CheckpointTemplate">
                <messages:MessageChrome>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔖" Foreground="{DynamicResource Dark.Text}" VerticalAlignment="Center" FontSize="14"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding Payload.DisplayTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Dark.Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Payload.Detail}" Foreground="#9A9A9A" FontFamily="Consolas" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Compare" Click="OnCheckpointCompare" Tag="{Binding}"
                                    Style="{StaticResource QuestionOptionButtonStyle}"/>
                            <Button Content="Restore" Click="OnCheckpointRestore" Tag="{Binding}" Margin="8,0,0,0"
                                    Style="{StaticResource QuestionOptionButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </messages:MessageChrome>
            </DataTemplate>

            <messages:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="MessageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}"
                      ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"/>
    </ScrollViewer>
</UserControl>