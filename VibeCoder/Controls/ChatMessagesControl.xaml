<UserControl x:Class="VibeCoder.Controls.ChatMessagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:VibeCoder.Core.Services;assembly=VibeCoder.Core"
             xmlns:conv="clr-namespace:VibeCoder.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Chat.UserBorder" Color="#CC64B5F6"/>
        <SolidColorBrush x:Key="Chat.UserBackground" Color="#3364B5F6"/>
        <SolidColorBrush x:Key="Chat.LastActBackground" Color="#334CAF50"/>
        <SolidColorBrush x:Key="Chat.LastActBorder" Color="#4CAF50"/>
        <SolidColorBrush x:Key="Chat.LastPlanBackground" Color="#4DFF8C00"/>
        <SolidColorBrush x:Key="Chat.LastPlanBorder" Color="#FF8C00"/>
        <SolidColorBrush x:Key="Question.OptionBorder" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Question.AnswerBorder" Color="#4CAF50"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:CodeTokensToTextBlockConverter x:Key="CodeToTextBlock"/>
        <conv:MarkdownToElementConverter x:Key="MarkdownToElement"/>
        <conv:OptionEqualsAnswerConverter x:Key="OptionEqualsAnswerConverter"/>

        <Style x:Key="CodeScrollViewerStyle" TargetType="ScrollViewer">
            <EventSetter Event="PreviewMouseWheel" Handler="OnCodeScrollPreviewMouseWheel"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dark.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuestionOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Question.OptionBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#666666" CornerRadius="2.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#999999"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Height" Value="5"/>
                                <Setter Property="MinHeight" Value="5"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type core:TextMessageBlock}">
            <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="{DynamicResource Dark.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.KindName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Error">
                                <Setter Property="Foreground" Value="{DynamicResource Dark.ErrorText}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:CodeMessageBlock}">
            <Border Background="{DynamicResource Code.Background}" BorderBrush="{DynamicResource Dark.Border}"
                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                <ScrollViewer Style="{StaticResource CodeScrollViewerStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Tokens, Mode=OneWay, Converter={StaticResource CodeToTextBlock}}"/>
                </ScrollViewer>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ChatMessageTemplate">
            <Border Padding="8,6" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Dark.Control}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Dark.Border}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding KindName}" Value="User">
                                <Setter Property="BorderBrush" Value="{StaticResource Chat.UserBorder}"/>
                                <Setter Property="Background" Value="{StaticResource Chat.UserBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ToolCall">
                                <Setter Property="BorderBrush" Value="{DynamicResource Dark.Border}"/>
                                <Setter Property="Background" Value="{DynamicResource Dark.Control}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ToolBlocked">
                                <Setter Property="BorderBrush" Value="#B0563C"/>
                                <Setter Property="Background" Value="#33221E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Error">
                                <Setter Property="BorderBrush" Value="#B0563C"/>
                                <Setter Property="Background" Value="#331F1F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Compaction">
                                <Setter Property="BorderBrush" Value="#6B6B2E"/>
                                <Setter Property="Background" Value="#262618"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                <Setter Property="Background" Value="#1E2733"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Question">
                                <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                <Setter Property="Background" Value="#1E2733"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Subagent">
                                <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                <Setter Property="Background" Value="#1E2733"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Checkpoint">
                                <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                <Setter Property="Background" Value="#1E2733"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                                <Setter Property="BorderBrush" Value="{StaticResource Chat.LastPlanBorder}"/>
                                <Setter Property="Background" Value="{StaticResource Chat.LastPlanBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                                <Setter Property="BorderBrush" Value="{StaticResource Chat.LastActBorder}"/>
                                <Setter Property="Background" Value="{StaticResource Chat.LastActBackground}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Expander Header="{Binding ReasoningHeader, Mode=OneWay}" IsExpanded="{Binding IsThinking, Mode=OneWay}"
                                  Foreground="{DynamicResource Dark.Text}"
                                  Visibility="{Binding ShowReasoning, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Reasoning, Mode=OneWay}" TextWrapping="Wrap"
                                     Foreground="#C8C8C8" FontStyle="Italic"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/>
                        </Expander>
                        <StackPanel x:Name="QuestionPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Payload.Question}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Dark.Text}"/>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.IsAnswered}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding Payload.Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Tag="{Binding}" Click="OnQuestionOptionClick"
                                                    Margin="0,0,6,4">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource QuestionOptionButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource OptionEqualsAnswerConverter}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.Payload.Answer" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Question.AnswerBorder}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Skip" Click="OnQuestionSkip" HorizontalAlignment="Left"
                                        Margin="0,4,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource QuestionOptionButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Payload.IsSkipped}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Question.AnswerBorder}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="SubagentPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Payload.Item.Prompt}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Dark.Text}"/>
                            <TextBlock Text="{Binding Payload.Item.StatusText}" Foreground="#C8C8C8" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Payload.Item.LatestToolCall}" Foreground="#9A9A9A" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Payload.Item.LatestToolCall}"/>
                            <Expander Header="Show output" Margin="0,8,0,0" Foreground="{DynamicResource Dark.Text}" IsExpanded="False"
                                      Visibility="{Binding Payload.Item.HasOutput, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding Payload.Item.Result, Mode=OneWay}" TextWrapping="Wrap"
                                         IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                         Foreground="{DynamicResource Dark.Text}" MaxHeight="400" VerticalScrollBarVisibility="Auto"/>
                            </Expander>
                            <TextBlock Text="{Binding Payload.Item.Error}" Foreground="{DynamicResource Dark.ErrorText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding Payload.Item.HasError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel x:Name="CheckpointPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔖" Foreground="{DynamicResource Dark.Text}" VerticalAlignment="Center" FontSize="14"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Payload.DisplayTitle}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Dark.Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Payload.Detail}" Foreground="#9A9A9A" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Compare" Click="OnCheckpointCompare" Tag="{Binding}"
                                        Style="{StaticResource QuestionOptionButtonStyle}"/>
                                <Button Content="Restore" Click="OnCheckpointRestore" Tag="{Binding}" Margin="8,0,0,0"
                                        Style="{StaticResource QuestionOptionButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="MarkdownPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Dark.Text}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <ContentControl Content="{Binding Text, Mode=OneWay, Converter={StaticResource MarkdownToElement}}"/>
                        </StackPanel>
                        <ItemsControl x:Name="BlocksPanel" ItemsSource="{Binding Blocks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"
                            Style="{StaticResource IconButtonStyle}" Width="16" Height="16"
                            ToolTip="Copy message" Click="OnCopyMessage">
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Fill="{DynamicResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding KindName}" Value="Question">
                    <Setter TargetName="QuestionPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="Subagent">
                    <Setter TargetName="SubagentPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="Checkpoint">
                    <Setter TargetName="CheckpointPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                    <Setter TargetName="MarkdownPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                    <Setter TargetName="MarkdownPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="MessageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}"
                      ItemTemplate="{StaticResource ChatMessageTemplate}"/>
    </ScrollViewer>
</UserControl>
