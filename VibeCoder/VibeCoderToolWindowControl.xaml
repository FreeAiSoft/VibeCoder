<UserControl x:Class="VibeCoder.VibeCoderToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolkit="clr-namespace:Agent.Toolkit.Wpf.Controls;assembly=Agent.Toolkit.Wpf">
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Chat">
            <toolkit:ChatControl x:Name="Chat" />
        </TabItem>
        <TabItem Header="Settings">
            <toolkit:SettingsControl x:Name="Settings" />
        </TabItem>
    </TabControl>
</UserControl>
