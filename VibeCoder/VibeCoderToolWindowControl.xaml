                                         Style="{StaticResource CompactOutlinedTextBox}"
                                         md:HintAssist.Hint="Speech language" Margin="0,0,0,8"/>

                                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="VoskModelPathBox"
                                         Style="{StaticResource CompactOutlinedTextBox}"
                                         md:HintAssist.Hint="Vosk model directory" Margin="0,0,0,8"/>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,4">
                                    <ToggleButton x:Name="SpeechAutoSendSwitch" Style="{StaticResource SwitchToggleButtonStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Auto-send voice input" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="20,8,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <md:NumericUpDown Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TimeoutSecondsUpDown"
                                                  Style="{StaticResource CompactOutlinedNumericUpDown}"
                                                  md:HintAssist.Hint="Request timeout (s)"
                                                  Margin="0,0,0,8"/>

                                <md:NumericUpDown Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RetryTimeoutMinutesUpDown"
                                                  Style="{StaticResource CompactOutlinedNumericUpDown}"
                                                  md:HintAssist.Hint="Retry budget (min)"
                                                  Margin="0,0,0,8"/>

                                <md:NumericUpDown Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RetryBaseDelaySecondsUpDown"
                                                  Style="{StaticResource CompactOutlinedNumericUpDown}"
                                                  md:HintAssist.Hint="Retry base delay (s)"
                                                  Margin="0,0,0,8"/>

                                <md:NumericUpDown Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RetryMaxDelaySecondsUpDown"
                                                  Style="{StaticResource CompactOutlinedNumericUpDown}"
                                                  md:HintAssist.Hint="Retry max delay (s)"
                                                  Margin="0,0,0,8"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,8,8,8">
                                <TextBlock Text="Primary prompt (pinned)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource Chat.UserBackground}" Padding="8,6" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top">
                                                <Polyline Points="9,18 15,12 9,6" Stroke="{DynamicResource Dark.Text}" StrokeThickness="2"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="You: Fix the null-check in the parser and add a regression test."/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0" Text="✕" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar Grid.Row="1" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="42"
                                                     Foreground="{DynamicResource Dark.Accent}"/>
                                        <TextBlock Grid.Row="2" Margin="0,4,0,0" Foreground="#C8C8C8" Text="Context window: 12.4k / 200k"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Notification banners" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <controls:NotificationBanner Kind="Trace" Message="Trace sample: most verbose level." Margin="0,0,0,8"/>
                                <controls:NotificationBanner Kind="Info" Message="Info sample: informational message." Margin="0,0,0,8"/>
                                <controls:NotificationBanner Kind="Success" Message="Success sample: action completed." Margin="0,0,0,8"/>
                                <controls:NotificationBanner Kind="Warning" Message="Warning sample: shows copy and send-to-chat." Margin="0,0,0,8"/>
                                <controls:NotificationBanner Kind="Error" Message="Error sample: shows copy and send-to-chat." Margin="0,0,0,8"/>

                                <TextBlock Text="Chat messages" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                <controls:ChatMessagesControl x:Name="GalleryChatMessages" MaxHeight="480"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,8,8,8">
                                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Light" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ToggleButton x:Name="DarkThemeToggle" VerticalAlignment="Center"
                                                  Style="{StaticResource SwitchToggleButtonStyle}"
                                                  Checked="OnThemeModeChanged" Unchecked="OnThemeModeChanged"
                                                  ToolTip="Toggle dark/light theme"/>
                                    <TextBlock Text="Dark" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="Dynamic color — seed hue" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Slider x:Name="SeedHueSlider" Width="220" Minimum="0" Maximum="360"
                                            TickFrequency="15" IsSnapToTickEnabled="False"
                                            SmallChange="1" LargeChange="15"
                                            ValueChanged="OnSeedHueChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SeedHueValueText" Text="256" VerticalAlignment="Center"
                                               Margin="10,0,0,0" Width="40"/>
                                    <Border x:Name="SeedPreview" Width="32" Height="32" CornerRadius="4"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            BorderThickness="1" BorderBrush="{DynamicResource Dark.Border}"/>
                                </StackPanel>

                                <ComboBox x:Name="ThemeVariantCombo" SelectedIndex="1" Margin="0,0,0,8"
                                          Style="{StaticResource CompactOutlinedComboBox}"
                                          md:HintAssist.Hint="Variant"
                                          SelectionChanged="OnThemeVariantChanged">
                                    <ComboBoxItem Content="Monochrome"/>
                                    <ComboBoxItem Content="Neutral"/>
                                    <ComboBoxItem Content="Tonal Spot"/>
                                    <ComboBoxItem Content="Vibrant"/>
                                    <ComboBoxItem Content="Expressive"/>
                                    <ComboBoxItem Content="Fidelity"/>
                                    <ComboBoxItem Content="Content"/>
                                    <ComboBoxItem Content="Rainbow"/>
                                    <ComboBoxItem Content="Fruit Salad"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Contrast" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="ThemeContrastSlider" Width="220" Minimum="0" Maximum="1"
                                                TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                                                ValueChanged="OnThemeContrastChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ThemeContrastValueText" Text="0.5" VerticalAlignment="Center"
                                                   Margin="10,0,0,0" Width="40"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Preset colors" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Click a color to apply it as primary (and secondary when available)."
                                           TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ThemeSwatchesList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="44" Height="44" Margin="2" CornerRadius="4"
                                                    Background="{Binding DisplayBrush}" ToolTip="{Binding Name}"
                                                    Cursor="Hand" MouseLeftButtonUp="OnThemeSwatchClick"
                                                    BorderThickness="1" BorderBrush="{DynamicResource Dark.Border}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,8,8,8">
                                <TextBlock Text="Proxy" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ToggleButton x:Name="ProxyEnabledSwitch" Style="{StaticResource SwitchToggleButtonStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Route requests through a proxy" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="ProxyHostBox"
                                             Style="{StaticResource CompactOutlinedTextBox}"
                                             md:HintAssist.Hint="Host" Margin="0,0,8,0"/>
                                    <md:NumericUpDown Grid.Column="1" x:Name="ProxyPortUpDown" Width="120"
                                                      Style="{StaticResource CompactOutlinedNumericUpDown}"
                                                      md:HintAssist.Hint="Port"/>
                                </Grid>

                                <TextBox x:Name="ProxyUsernameBox"
                                         Style="{StaticResource CompactOutlinedTextBox}"
                                         md:HintAssist.Hint="Username (optional)" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="ProxyPasswordBox"
                                             Style="{StaticResource CompactOutlinedPasswordBox}"
                                             md:HintAssist.Hint="Password (optional)" Margin="0,0,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Margin="0,0,8,0" Style="{StaticResource SettingsNavActionButton}" Click="OnSaveSettings" ToolTip="Save settings">
                        <md:PackIcon Kind="ContentSaveCogOutline" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    </Button>
                    <Button Style="{StaticResource SettingsNavActionButton}" Click="OnRefreshPromptsFromDisk" ToolTip="Update prompts">
                        <md:PackIcon Kind="Reload" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    </Button>
                </StackPanel>
            </Grid>
            </Grid>
        </TabItem>


    </TabControl>
</UserControl>
