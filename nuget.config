<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Local AgentShared feed plus the public nuget.org source. The packageSourceMapping
    keeps the build deterministic: everything public comes from nuget.org and only the
    Agent.* packages come from the local feed. This also overrides the third-party
    MaterialDesign repo's <clear/> so its transitive net462 dependencies (Polyfill etc.)
    still resolve.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AgentShared" value="C:\Users\Maxxx\source\repos\AgentShared\feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="AgentShared">
      <package pattern="Agent.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>